{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LV999",
  "version": "0.1.0",
  "identifier": "com.rampageboo.lv999",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "LV999", "width": 1200, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRDAyRjk3MjI5QjNBQ0IKUldUTE9wc2lseS9RWUZ4c1E4bVFiYXZBRkhmTWZSL0VMN2xZdllnVjZ6c2svR3pQMXdNMTVpaUsK",
      "endpoints": ["https://github.com/Rampageboo/LV999/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "startMenuFolder": "LV999 Notion", "template": "installer/template.nsi" } }
  }
}
