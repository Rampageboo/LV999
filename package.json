{
  "name": "lv999",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:desktop": "node scripts/build-server.mjs && npm run prepare:runtime && npm run dev",
    "desktop": "node scripts/tauri.mjs dev",
    "build": "npm run typecheck && node scripts/build-server.mjs && vite build --config apps/desktop/vite.config.ts",
    "build:bundle": "npm run build && npm run prepare:runtime",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:workspace-gui": "node scripts/workspace-gui-smoke.mjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "package:desktop": "node scripts/tauri.mjs build --bundles nsis",
    "cli": "node dist/server/backend.mjs cli",
    "mcp": "node dist/server/backend.mjs mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@notionhq/client": "5.31.1",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
